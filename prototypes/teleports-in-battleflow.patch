+  });
+  it("Dimension Door crosses a sight wall but still wants an empty space", () => {
+    expect(t.teleportVerdict({ row: door, sightBlocked: true }).allowed).toBe(true);
+    expect(t.teleportVerdict({ row: door, occupied: true }).allowed).toBe(false);
+  });
+});
+
+describe("footprintsOverlap — a square is its interior, not its border", () => {
+  const dest = { x: 100, y: 100, w: 100, h: 100 };
+  it("the same square overlaps; a neighbour touching an edge does not", () => {
+    expect(t.footprintsOverlap(dest, { x: 100, y: 100, w: 100, h: 100 })).toBe(true);
+    expect(t.footprintsOverlap(dest, { x: 200, y: 100, w: 100, h: 100 })).toBe(false);
+    expect(t.footprintsOverlap(dest, { x: 100, y: 0, w: 100, h: 100 })).toBe(false);
+  });
+  it("a Large creature covering the square overlaps", () => {
+    expect(t.footprintsOverlap(dest, { x: 50, y: 50, w: 200, h: 200 })).toBe(true);
+  });
+});
