@@ -0,0 +1,72 @@
+import { beforeAll, describe, expect, it } from "vitest";
+
+/** DECISION-layer teleport verdicts (ARCHITECTURE.md §2). No Foundry stub on purpose. */
+/** @type {typeof import("../scripts/decide/teleports.js")} */
+let t;
+/** @type {typeof import("../scripts/decide/registry.js")} */
+let reg;
+beforeAll(async () => {
+  t = await import("../scripts/decide/teleports.js");
+  reg = await import("../scripts/decide/registry.js");
+});
+
+describe("TELEPORTS — the rows the packs ship (user, 2026-09-04: Misty Step blocked by walls and tokens)", () => {
+  it("every row says whether it needs sight and an unoccupied space, and quotes its rule", () => {
+    for (const [name, row] of Object.entries(reg.TELEPORTS)) {
+      expect(typeof row.sight, name).toBe("boolean");
+      expect(typeof row.unoccupied, name).toBe("boolean");
+      expect(row.rule, name).toMatch(/teleport/i);
+    }
+  });
+  it("Misty Step needs both; Dimension Door needs no line of sight", () => {
+    expect(reg.TELEPORTS["Misty Step"]).toMatchObject({ sight: true, unoccupied: true });
+    expect(reg.TELEPORTS["Dimension Door"]).toMatchObject({ sight: false, unoccupied: true });
+  });
+  it("the list's kinds are the row names, lower-cased, and the default lists them all", () => {
+    expect([...reg.TELEPORT_NAMES]).toEqual(Object.keys(reg.TELEPORTS).map(n => n.toLowerCase()));
+    expect(reg.LIST_SPECS.teleports.default).toBe(Object.keys(reg.TELEPORTS).join(", "));
+  });
+});
+
+describe("teleportRowFor — by name, case-insensitive", () => {
+  it("finds Misty Step however it is cased, and nothing for a stranger", () => {
+    expect(t.teleportRowFor("misty step", reg.TELEPORTS)?.key).toBe("Misty Step");
+    expect(t.teleportRowFor("MISTY STEP ", reg.TELEPORTS)?.key).toBe("Misty Step");
+    expect(t.teleportRowFor("Fireball", reg.TELEPORTS)).toBeNull();
+    expect(t.teleportRowFor("", reg.TELEPORTS)).toBeNull();
+    expect(t.teleportRowFor(undefined, reg.TELEPORTS)).toBeNull();
+  });
+});
+
+describe("teleportVerdict — the rule's two facts", () => {
+  const misty = reg.TELEPORTS["Misty Step"];
+  const door = reg.TELEPORTS["Dimension Door"];
+  it("a clear, empty destination is allowed", () => {
+    expect(t.teleportVerdict({ row: misty })).toEqual({ allowed: true, reason: null });
+  });
+  it("a sight wall refuses Misty Step, and says so in the rule's words", () => {
+    const v = t.teleportVerdict({ row: misty, sightBlocked: true });
+    expect(v.allowed).toBe(false);
+    expect(v.reason).toMatch(/space you can see/);
+  });
+  it("an occupied destination refuses, sight first when both fail", () => {
+    expect(t.teleportVerdict({ row: misty, occupied: true }).reason).toMatch(/unoccupied space/);
