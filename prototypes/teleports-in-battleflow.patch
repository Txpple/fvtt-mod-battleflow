index 0000000..32fc304
--- /dev/null
+++ b/scripts/decide/teleports.js
@@ -0,0 +1,46 @@
+// @ts-check
+/**
+ * Battle Flow — DECISION layer: teleports (ARCHITECTURE.md §2). Pure. No Foundry, no globals.
+ *
+ * A listed teleport's move is judged from plain facts the EDGE measured — whether a sight wall
+ * stands between the caster and the destination, whether a creature stands on it — against the
+ * row's own text (TELEPORTS, decide/registry.js): "an unoccupied space you can see" is two
+ * facts, and a row may want only one of them (Dimension Door needs no line of sight).
+ */
+
+/**
+ * The teleport row for an item, by name, case-insensitive — `{ key, row }` or null.
+ * @param {string} name
+ * @param {Readonly<Record<string, Readonly<{sight: boolean, unoccupied: boolean, rule: string}>>>} table
+ */
+export function teleportRowFor(name, table) {
+  const wanted = String(name ?? "").trim().toLowerCase();
+  if ( !wanted ) return null;
+  const key = Object.keys(table ?? {}).find(k => k.toLowerCase() === wanted);
+  return key ? { key, row: table[key] } : null;
+}
+
+/**
+ * THE VERDICT on a destination: allowed, or refused with the rule's own words. Refusal names
+ * the first fact that fails, sight before occupancy — the order the text reads in.
+ * @param {{row: Readonly<{sight: boolean, unoccupied: boolean}>, sightBlocked?: boolean, occupied?: boolean}} facts
+ * @returns {{allowed: boolean, reason: string|null}}
+ */
+export function teleportVerdict({ row, sightBlocked = false, occupied = false }) {
+  if ( row?.sight && sightBlocked ) return { allowed: false, reason: "the destination must be a space you can see — a wall stands between you and it" };
+  if ( row?.unoccupied && occupied ) return { allowed: false, reason: "the destination must be an unoccupied space — a creature stands there" };
+  return { allowed: true, reason: null };
+}
+
+/**
+ * Does a token standing at `other` overlap the destination footprint? Axis-aligned, in pixels,
+ * with a one-pixel tolerance so touching edges do not count — the same reading the rule wants
+ * ("a space" is the square, not its border).
+ * @param {{x: number, y: number, w: number, h: number}} dest
+ * @param {{x: number, y: number, w: number, h: number}} other
+ */
+export function footprintsOverlap(dest, other) {
+  const eps = 1;
+  return (other.x < dest.x + dest.w - eps) && (other.x + other.w > dest.x + eps)
+    && (other.y < dest.y + dest.h - eps) && (other.y + other.h > dest.y + eps);
+}
