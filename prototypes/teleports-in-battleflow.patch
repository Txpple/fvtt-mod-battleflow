index 0000000..5a920d1
--- /dev/null
+++ b/scripts/teleports.js
@@ -0,0 +1,175 @@
+/**
+ * Battle Flow — Teleports: a listed teleport's move crosses walls and creatures, and the
+ * destination is judged by the spell's own words (user, 2026-09-04: "when I click it a circle
+ * comes up, and I can choose where to teleport. however it gets blocked if there is a wall or
+ * other token in the way. can it be fixed"). Split by feature (ARCHITECTURE.md §7);
+ * battleflow.js is the only esmodules entry.
+ *
+ * WHAT WAS MEASURED (NOTES §1, the test range, 2026-09-04): the animation module's teleport
+ * (Automated Animations' circle-and-click) moves the token with a bare `document.move()` — no
+ * action, no constrain options. Foundry 14 walks a bare move: a wall stops it, and dnd5e's full
+ * movement automation stops it at a hostile creature. The `blink` action is wall-checked too
+ * (walls: "move"). Only `displace` — Foundry's own teleport action (teleport: true, walls: null)
+ * — crosses both, and a token's DEFAULT movement action may be set to it. So the machine, on the
+ * caster's own client at a listed use, gives the token that action for the one move that follows
+ * — the animation's, or a drag by hand — and takes it back the moment the move lands, or when
+ * the window closes with no move. Nothing else about the platform's pipeline is touched.
+ *
+ * WHAT IS JUDGED (decide/teleports.js): the move that arrives while the token is armed meets
+ * `preMoveToken` — Foundry's veto seat, after the platform constrained the path and before it
+ * commits — and the destination is measured against the row: a sight-blocking wall between the
+ * caster's centre and the destination's refuses a `sight` row ("a space you can see"); a
+ * creature standing on the destination refuses an `unoccupied` row. A refusal is a notice and
+ * no move; the token stays armed, so the player may pick again or drag. Range is not judged —
+ * the animation's circle and the table hold it. ⚠ The animation module's OWN "check collision"
+ * option is a move-collision ray it tests before any move exists, and it is that preset's
+ * setting, not this module's: with it on, a wall still refuses at the circle, before the machine
+ * sees anything. Switch it off on the teleport presets (Automated Animations → Autorec →
+ * Preset → Misty Step) to let the rule here be the only judge.
+ *
+ * WHERE IT RUNS: the using client, which owns the token (dnd5e.postUseActivity fires where the
+ * item was used, and the animation moves the token from the same client). No elect, no GM
+ * needed — the arm and the disarm are the owner's own token updates.
+ *
+ * WHAT IT NEVER TOUCHES: an unlisted item; a move with no arm on the token; the token's other
+ * data. The prior movement action is kept on the arm flag and restored exactly, including "not
+ * set" (null — the platform infers walk/fly from the sheet).
+ */
+import { MODULE_ID, S, TITLE, setting } from "./core.js";
+import { TELEPORTS } from "./decide/registry.js";
+import { footprintsOverlap, teleportRowFor, teleportVerdict } from "./decide/teleports.js";
+import { teleportEntries } from "./settings.js";
+
+/** The arm on the TOKEN: `{ name, previousAction, armedAt }`. */
+const ARM_FLAG = "teleport";
+/** How long an arm stands with no move — the circle's pick is seconds; a minute covers a drag by hand. */
+export const TELEPORT_WINDOW_MS = 120_000;
+/** The disarm clocks, by token uuid — this client's own. */
+const clocks = new Map();
+
+/** The listed row for an activity's item, or null — the switch and the list, then the table. */
+function rowFor(activity) {
+  if ( !setting(S.teleports) ) return null;
+  const found = teleportRowFor(activity?.item?.name ?? "", TELEPORTS);
+  if ( !found ) return null;
+  if ( !teleportEntries().some(e => e.kind === found.key.toLowerCase()) ) return null;
+  return found;
+}
+
+/** The caster's token on a scene — a synthetic actor's own, else the first active one. */
+function tokenOf(actor) {
+  const tok = actor?.token ?? actor?.getActiveTokens?.(true, true)?.[0] ?? null;
+  return tok?.parent ? tok : null;
+}
+
+const armOf = tok => tok?.getFlag?.(MODULE_ID, ARM_FLAG) ?? null;
+
+/**
+ * ARM: the token's next move is the teleport. The prior action is what the SOURCE holds (null
+ * when the sheet infers it), never the inferred value, so the restore puts back exactly what
+ * was there. A re-arm while armed keeps the original prior — two casts must not leave
+ * "displace" behind as the remembered default.
+ */
+async function arm(tok, key) {
+  const prior = armOf(tok);
+  const previousAction = prior ? prior.previousAction : (tok._source?.movementAction ?? null);
+  await tok.update({ movementAction: "displace", [`flags.${MODULE_ID}.${ARM_FLAG}`]: { name: key, previousAction, armedAt: Date.now() } },
+    { bfTeleportArm: true });
+  scheduleDisarm(tok);
+}
+
+/** DISARM: the action restored exactly, the flag gone. The owner's write; a lost race is fine. */
+async function disarm(tok) {
+  clearClock(tok);
+  const flag = armOf(tok);
+  if ( !flag || !tok.isOwner ) return;
+  try {
+    await tok.update({ movementAction: flag.previousAction ?? null, [`flags.${MODULE_ID}.-=${ARM_FLAG}`]: null },
+      { bfTeleportDisarm: true });
+  } catch(err) {
+    console.warn(`${TITLE} | Could not restore the token's movement action after a teleport.`, err);
+  }
+}
+
+function scheduleDisarm(tok) {
+  clearClock(tok);
+  clocks.set(tok.uuid, setTimeout(() => { clocks.delete(tok.uuid); void disarm(tok); }, TELEPORT_WINDOW_MS));
+}
+function clearClock(tok) {
+  const id = clocks.get(tok?.uuid);
+  if ( id ) clearTimeout(id);
+  clocks.delete(tok?.uuid);
+}
+
+/** The destination's footprint in pixels, and whether a creature stands on it. */
+function occupiedAt(tok, dest) {
+  const grid = tok.parent.grid;
+  const footprint = { x: dest.x, y: dest.y, w: (dest.width ?? tok.width) * grid.sizeX, h: (dest.height ?? tok.height) * grid.sizeY };
+  return tok.parent.tokens.some(t => (t.id !== tok.id) && (t.actor?.system?.isCreature !== false)
+    && footprintsOverlap(footprint, { x: t.x, y: t.y, w: t.width * grid.sizeX, h: t.height * grid.sizeY }));
+}
+
+/** A sight-blocking wall between the token's centre and the destination's? */
+function sightBlockedTo(tok, dest) {
+  const centre = pos => (typeof tok.getCenterPoint === "function") ? tok.getCenterPoint(pos)
+    : { x: pos.x + (tok.width * tok.parent.grid.sizeX) / 2, y: pos.y + (tok.height * tok.parent.grid.sizeY) / 2 };
+  const from = tok.object?.center ?? centre({ x: tok.x, y: tok.y });
+  const to = centre({ x: dest.x, y: dest.y });
+  return !!CONFIG.Canvas.polygonBackends.sight.testCollision(from, to, { type: "sight", mode: "any" });
+}
+
+// THE ARM — a listed item used, on the using client.
+Hooks.on("dnd5e.postUseActivity", (activity) => {
+  try {
+    const found = rowFor(activity);
+    if ( !found ) return;
+    const actor = activity.actor;
+    if ( !actor?.isOwner ) return;
+    const tok = tokenOf(actor);
+    if ( !tok?.isOwner ) return;
+    void arm(tok, found.key);
+  } catch(err) {
+    console.error(`${TITLE} | Teleport arm failed — the move is the platform's.`, err);
+  }
+});
+
+// THE JUDGEMENT — the move that arrives while armed. Foundry's veto seat: `false` refuses.
+Hooks.on("preMoveToken", (tok, move) => {
+  try {
+    const flag = armOf(tok);
+    if ( !flag ) return;
+    const row = TELEPORTS[flag.name];
+    if ( !row ) return;
+    const dest = move.destination;
+    const verdict = teleportVerdict({ row, sightBlocked: row.sight ? sightBlockedTo(tok, dest) : false,
+      occupied: row.unoccupied ? occupiedAt(tok, dest) : false });
+    if ( verdict.allowed ) return;
+    ui.notifications?.warn(`${flag.name}: ${verdict.reason}.`);
+    return false;
+  } catch(err) {
+    console.error(`${TITLE} | Teleport judgement failed — the move is the platform's.`, err);
+  }
+});
+
+// THE LANDING — the armed move committed: the action goes back.
+Hooks.on("moveToken", (tok) => {
+  try {
+    if ( armOf(tok) ) void disarm(tok);
+  } catch(err) {
+    console.error(`${TITLE} | Teleport disarm failed.`, err);
+  }
+});
+
+Hooks.on("deleteToken", (tok) => { clearClock(tok); });
+
+// A stale arm — a client that closed mid-window — is taken back by its owner at the next canvas.
+Hooks.on("canvasReady", (cnv) => {
+  try {
+    for ( const tok of (cnv?.scene?.tokens ?? []) ) {
+      const flag = armOf(tok);
+      if ( flag && tok.isOwner && ((Date.now() - (flag.armedAt ?? 0)) > TELEPORT_WINDOW_MS) ) void disarm(tok);
+    }
+  } catch(err) {
+    console.warn(`${TITLE} | Stale teleport sweep failed.`, err);
+  }
+});
