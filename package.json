{
  "name": "fvtt-mod-battleflow",
  "private": true,
  "type": "module",
  "description": "Development tooling for Battle Flow. NOTHING HERE SHIPS — the module is plain ES modules loaded straight from scripts/, with no build step (PLAN.md Phase 0.1).",
  "scripts": {
    "verify": "npm run check && npm run knip && npm run typecheck && npm run imports && npm run cardreads && npm run layers && npm run coverage && npm run hooks && npm run dispatch && npm run surfaces && npm run registry && npm run moments && npm run manifest && npm run comments && npm run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint ./scripts",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "imports": "node tools/check-imports.mjs",
    "cardreads": "node tools/check-card-reads.mjs",
    "layers": "node tools/check-layers.mjs",
    "coverage": "node tools/check-coverage-map.mjs",
    "hooks": "node tools/check-hook-order.mjs",
    "dispatch": "node tools/check-hook-dispatch.mjs",
    "surfaces": "node tools/check-surfaces.mjs",
    "registry": "node tools/check-registry.mjs",
    "moments": "node tools/check-moments.mjs",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "comments": "node tools/check-comments.mjs",
    "manifest": "node tools/bump-version.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.0.0",
    "fvtt-mcp-dnd5e": "file:../fvtt-mcp-dnd5e",
    "knip": "^5.64.0",
    "typescript": "^6.0.3",
    "vitest": "~3.2.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Txpple",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Txpple/fvtt-mod-battleflow.git"
  }
}
